// The first leg of the Pylgrymage, Yhlgrym to Atzhaim, and the lands around
// it: Shentzlia, Maphlia, the bay of Aphlora and the nearer Triadyk coast.
//
// Names, Krypts, rites and nedias come from "the city temples.txt", the map
// and the vault notes. Everything marked ASSUMPTION is a placeholder to replace.
//
// The places and roads follow the map as drawn in "Triadic-Atzchil Region
// Updates.psdc" (the screenshot of 31 May 2026). Places are spelled as the
// map labels them.
#![enable(implicit_some)]
(
    start: (
        // 192 zdy is the year of the Reflections on the Pylgrymage.
        // ASSUMPTION: the month and day the walk begins.
        year: 192,
        month: 1,
        day: 1,
        // Change the seed to get a different run of road encounters.
        seed: 192,
        party_at: "yhlgrym",
    ),

    places: [
        (
            key: "yhlgrym",
            name: "Yhlgrym",
            kind: TempleCity,
            region: Shentzlia,
            temple: (
                krypt_of: "Grymsiere",
                rite: "Holy Oath and Unification Ceremony",
                nedia: ["History", "Ecumenycal monology"],
            ),
            sites: [
                (key: "gate", name: "North Gate", kind: Gate), // ASSUMPTION: one gate for both roads.
                (key: "krypt", name: "Krypt of Grymsiere", kind: Temple),
                (key: "nedia", name: "Nedia Hyl", kind: Nedia), // The towers and courtyards on the nedia hyl.
                (key: "court", name: "City Court", kind: Court),
                (key: "inn", name: "Inn", kind: Inn), // ASSUMPTION
                (key: "farms", name: "Farms", kind: Landmark), // The farms scattered about the Krypt.
                (key: "market", name: "Market", kind: Market), // ASSUMPTION
                (key: "palace", name: "Palace", kind: Palace), // ASSUMPTION
            ],
        ),
        (
            key: "falls",
            name: "Hylvynhani Falls",
            kind: Town,
            region: Shentzlia,
        ),
        (
            key: "hylhaim",
            name: "Hylhaim-Shentzli",
            kind: Town,
            region: Shentzlia,
        ),
        (
            key: "heedhaim",
            name: "Heedhaim",
            kind: Town,
            region: Shentzlia,
        ),
        (
            key: "atzhaim",
            name: "Atzhaim",
            kind: TempleCity,
            region: Shentzlia,
            temple: (
                krypt_of: "Phionyx",
                rite: "Rites of Consummation",
                nedia: ["Fertility", "Lineology", "Climatology"],
                // Burned by Felydian and not yet restored.
                ruined: true,
            ),
            sites: [
                // ASSUMPTION: which gate faces which road.
                (key: "south-gate", name: "South Gate", kind: Gate, faces: ["falls", "hylhaim", "heedhaim"]),
                (key: "west-gate", name: "West Gate", kind: Gate, faces: ["drazihaim", "atzchhelm-ivhaan"]),
                (key: "krypt", name: "Krypt of Phionyx", kind: Temple), // A lone cathedral on a butte at the city's heart.
                (key: "nedia", name: "Nedia Floor", kind: Nedia), // "The largest nedia floor in all the Umbara."
                (key: "library", name: "Library", kind: Landmark),
                (key: "hospital", name: "Hospital", kind: Landmark),
                (key: "docks", name: "Lake Docks", kind: Landmark),
                (key: "drake", name: "Krypt of Drake", kind: Temple), // "Just beyond the Inner Wall."
                (key: "khaska", name: "Krypt of Khaska", kind: Temple), // In the second district.
                (key: "khodos", name: "Krypt of Khodos", kind: Temple), // In the second district.
                (key: "ilys", name: "Krypt of Ilys", kind: Temple),
                (key: "court", name: "City Court", kind: Court),
                (key: "inn", name: "Inn", kind: Inn), // ASSUMPTION
                (key: "market", name: "Market", kind: Market), // ASSUMPTION
            ],
        ),

        // Beyond the first leg. These come from the character and Beyond
        // notes in the vault; where they sit on the map is mostly guessed.
        (
            // The Krypt of Drake, home of the Hylvannus Kraiark of Law. Also
            // written Drazihaim Hylhelm and Drazilhaim-Hylhelm; the 2024
            // notes put the Temple of Drake at Cascadia, in the northwestern
            // Shentzlian valley.
            key: "drazihaim",
            name: "Drazihaim",
            kind: TempleCity,
            region: Shentzlia,
            temple: (
                krypt_of: "Drake",
                nedia: ["Law"],
            ),
            sites: [
                (key: "gate", name: "Gate", kind: Gate), // ASSUMPTION
                (key: "krypt", name: "Krypt of Drake", kind: Temple), // Home of the Hylvannus Kraiark of Law.
                (key: "nedia", name: "Nedia of Law", kind: Nedia),
                (key: "court", name: "City Court", kind: Court),
                (key: "inn", name: "Inn", kind: Inn), // ASSUMPTION
            ],
        ),
        (
            // "The Raven's nest", atop the Hyl'nuizt Eltzi at the northernmost
            // finger of the Great Valley of Shentz. Choratzch and Koratzch in
            // older notes. Hesseh trained at its nedia.
            key: "khoratzh",
            name: "Khoratzh",
            kind: TempleCity,
            region: Shentzlia,
            temple: (
                krypt_of: "Khaska",
            ),
            sites: [
                (key: "gate", name: "Gate", kind: Gate), // ASSUMPTION
                (key: "krypt", name: "Krypt of Khaska", kind: Temple), // "The Raven's nest", atop the Hyl'nuizt Eltzi.
                (key: "nedia", name: "Nedia", kind: Nedia), // Where Hesseh trained.
                (key: "court", name: "City Court", kind: Court),
            ],
        ),
        (
            // Seat of Governor of Phorva, and home of the
            // Palace. Its inner district holds a Krypt of
            // Khaska with the Khaskylil's tower. Not a city of the Road.
            key: "maphlamar",
            name: "Maphlamar",
            kind: Town,
            region: Maphlia,
            temple: (
                krypt_of: "Khaska",
            ),
            sites: [
                (key: "gate", name: "Gate", kind: Gate), // ASSUMPTION
                (key: "krypt", name: "Krypt of Khaska", kind: Temple), // In the inner district: towers, a library, a cathedral.
                (key: "tower", name: "Khaskylil's Tower", kind: Landmark),
                (key: "estate", name: "Pentor Palace", kind: Residence), 
                (key: "inn", name: "Inn", kind: Inn), // ASSUMPTION
                (key: "market", name: "Market", kind: Market), // ASSUMPTION
            ],
        ),
        (
            // Seat of the Grymsol Pynumbros of Maphlia (the Line of Field).
            // Its Krypt of Khaska and Library enclose the city's nedia.
            // Spelled Clate in the list of the towns of Maphlia.
            key: "klate",
            name: "Klate",
            kind: Town,
            region: Maphlia,
            temple: (
                krypt_of: "Khaska",
            ),
            sites: [
                (key: "gate", name: "Gate", kind: Gate), // ASSUMPTION
                (key: "seat", name: "Seat of the Pynumbros", kind: Palace), // Of the Line of Field.
                (key: "krypt", name: "Krypt of Khaska", kind: Temple),
                (key: "library", name: "Library of Klate", kind: Landmark),
                (key: "nedia", name: "Nedia", kind: Nedia), // Enclosed by the Krypt and the Library.
                (key: "inn", name: "Inn", kind: Inn), // ASSUMPTION
            ],
        ),
        (
            // Halion Dane is its Prefect.
            key: "seawalt",
            name: "The Seawalt",
            kind: Town,
            region: Maphlia,
        ),
        (
            // A town of Yhlmahni. The region is left out: Yhlmahni is not one
            // of the four Pynumbra.
            key: "sthepenhall",
            name: "Sthepenhall",
            kind: Town,
        ),

        // ---- Added from the map. None of these has sites yet. ----

        // Shentzlia, the Great Valley.
        (
            // On the east shore of the Atzch Lake.
            key: "atzch-midili",
            name: "Atzch-Midili",
            kind: Town,
            region: Shentzlia,
        ),
        (
            key: "coplahaim",
            name: "Coplahaim",
            kind: Town,
            region: Shentzlia,
        ),
        (
            // Atzchelm-Ivhaan in the list of the towns of Shentzlia.
            key: "atzchhelm-ivhaan",
            name: "Atzchhelm-Ivhaan",
            kind: Town,
            region: Shentzlia,
        ),
        (
            // A keep upriver of the Great Valley. The map draws no road to it.
            key: "bluestone",
            name: "Bluestone",
            kind: Landmark,
            region: Shentzlia,
        ),

        // The Triadyk coast of Ptormia (Vhinhelm in the old lists).
        (
            // The southernmost town of Ptormia.
            key: "ulugrozt",
            name: "Ulugrozt",
            kind: Town,
            region: Ptormia,
        ),
        (
            key: "vhimyst",
            name: "Vhimyst",
            kind: Town,
            region: Ptormia,
        ),
        (
            key: "trystzor",
            name: "Trystzor",
            kind: Town,
            region: Ptormia,
        ),
        (
            // In the mountains north of Khoratzh.
            key: "vinniv-pti",
            name: "Vinniv'pti",
            kind: Town,
            region: Ptormia,
        ),

        // Aphlora, the lowlands around the bay. The old list of the towns of
        // Maphlia holds Bahour-Ilos, Sima, Hila, Idra and Ebyni; they are put
        // in Aphlora here because Bahour-Ilos is Aphlora's southwesternmost
        // city and Maphlia ends at Rhait.
        (
            key: "bahour-ilos",
            name: "Bahour-Ilos",
            kind: Town,
            region: Aphlora,
        ),
        (
            key: "sima",
            name: "Sima",
            kind: Town,
            region: Aphlora,
        ),
        (
            key: "hila",
            name: "Hila",
            kind: Town,
            region: Aphlora,
        ),
        (
            key: "idra",
            name: "Idra",
            kind: Town,
            region: Aphlora,
        ),
        (
            key: "ebyni",
            name: "Ebyni",
            kind: Town,
