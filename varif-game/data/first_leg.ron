            // At the head of the bay.
            key: "stonesteps",
            name: "Stonesteps",
            kind: Town,
            region: Aphlora,
        ),
        (
            // The Umbral seat since Felydian moved it here.
            key: "penhyla",
            name: "Penhyla",
            kind: Town,
            region: Aphlora,
        ),
        (
            key: "ebynshor",
            name: "Ebynshor",
            kind: Town,
            region: Aphlora,
        ),
        (
            // In the mountains north of the bay.
            key: "lytzvia",
            name: "Lytzvia",
            kind: Town,
            region: Aphlora,
        ),

        // Maphlia, the Maphyk plateau.
        (
            key: "pheo",
            name: "Pheo",
            kind: Town,
            region: Maphlia,
        ),
        (
            key: "edun",
            name: "Edun",
            kind: Town,
            region: Maphlia,
        ),
        (
            key: "laad",
            name: "Laad",
