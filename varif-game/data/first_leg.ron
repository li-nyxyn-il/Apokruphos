    // The roads follow the map. Where three roads meet at a fork with no town
    // (the map has five), each pair of towns is given its own road through it.
    //
    // Every distance is measured along the road as drawn on the map, with
    // one measuring stick: Maphlamar to Klate, by Corvus, is 80 leagues. That
    // makes a league about 1.74 pixels of the map image.
    //
    // ASSUMPTION: something is added to the measured length where a road
    // winds (the canyon of the Yhl, the hill tracks), and Yhlgrym's two
    // roads split the Sthepenhall-falls road at a guessed point.
    // ASSUMPTION: every encounter chance.
    roads: [
        // ---- The Great Atzch Road and the Great Valley ----
        (from: "falls", to: "yhlgrym", leagues: 15, encounter_chance: 10),
        // The road up the canyon of the Yhl. An unnamed place is drawn on it
        // a little above the falls. Hylhaim-Shentzli is not on this road.
        (from: "yhlgrym", to: "atzhaim", leagues: 60, encounter_chance: 25),
        (from: "heedhaim", to: "atzhaim", leagues: 24, encounter_chance: 15),
        // Hylhaim-Shentzli's road ends at a fork on the south shore of the
        // lake, between Atzhaim and Heedhaim.
        (from: "hylhaim", to: "heedhaim", leagues: 50, encounter_chance: 20),
        (from: "hylhaim", to: "atzhaim", leagues: 47, encounter_chance: 20),
        // Up the west shore to a fork at the head of the lake, where the roads
        // to Drazihaim and Atzchhelm-Ivhaan part.
        (from: "atzhaim", to: "drazihaim", leagues: 90, encounter_chance: 20),
        (from: "atzchhelm-ivhaan", to: "atzhaim", leagues: 103, encounter_chance: 20),
        (from: "atzchhelm-ivhaan", to: "drazihaim", leagues: 125, encounter_chance: 20),
        (from: "drazihaim", to: "khoratzh", leagues: 50, encounter_chance: 20),
        // Up the east shore to Coplahaim, where the road ends.
        (from: "heedhaim", to: "atzch-midili", leagues: 35, encounter_chance: 15),
        (from: "atzch-midili", to: "coplahaim", leagues: 56, encounter_chance: 15),

        // ---- Yhlmahni and the south road of Maphlia ----
        // ASSUMPTION: Yhlgrym is not on the map; it stands here on the road
        // between Sthepenhall and the falls.
        (from: "falls", to: "sthepenhall", leagues: 27, encounter_chance: 20),
        (from: "sthepenhall", to: "ayin-lil", leagues: 31, encounter_chance: 20),
        (from: "ayin-lil", to: "nihuloz", leagues: 39, encounter_chance: 20),
        // Aiden rides from Maphlamar to Klate, then on to the Falls, where he
        // meets Emanda: by Corvus, the south road and Sthepenhall.
        (from: "sthepenhall", to: "pheo", leagues: 54, encounter_chance: 15),
        (from: "pheo", to: "edun", leagues: 14, encounter_chance: 15),
        (from: "edun", to: "laad", leagues: 13, encounter_chance: 15),
        (from: "laad", to: "hases", leagues: 23, encounter_chance: 15),
        (from: "hases", to: "klate", leagues: 21, encounter_chance: 15),
        (from: "klate", to: "corvus", leagues: 60, encounter_chance: 15),
        (from: "corvus", to: "maphlamar", leagues: 20, encounter_chance: 10),

        // ---- Maphlia's coast ----
        (from: "maphlamar", to: "seawalt", leagues: 59, encounter_chance: 15),
        (from: "seawalt", to: "danon", leagues: 35, encounter_chance: 15),
        (from: "seawalt", to: "rhait", leagues: 43, encounter_chance: 15),
        (from: "rhait", to: "ebyni", leagues: 29, encounter_chance: 15),

        // ---- Aphlora ----
        (from: "maphlamar", to: "sima", leagues: 74, encounter_chance: 15),
        (from: "sima", to: "hila", leagues: 6, encounter_chance: 5),
        // East of Hila the road forks, to Idra and to Ebyni.
        (from: "hila", to: "idra", leagues: 36, encounter_chance: 10),
        (from: "hila", to: "ebyni", leagues: 40, encounter_chance: 15),
        (from: "idra", to: "ebyni", leagues: 58, encounter_chance: 15),
        (from: "sima", to: "allenia", leagues: 43, encounter_chance: 10),
        (from: "allenia", to: "vormia", leagues: 22, encounter_chance: 10),
        // East of Vormia the road forks, to Stonesteps and to Porthelm.
        (from: "vormia", to: "stonesteps", leagues: 61, encounter_chance: 15),
        (from: "vormia", to: "porthelm", leagues: 54, encounter_chance: 15),
        (from: "stonesteps", to: "porthelm", leagues: 86, encounter_chance: 15),
        // North-east of Stonesteps three roads meet: from Stonesteps, from
        // Lytzvia and from Penhyla. A fourth runs on east off the screenshot.
        (from: "stonesteps", to: "penhyla", leagues: 134, encounter_chance: 15),
        (from: "stonesteps", to: "lytzvia", leagues: 139, encounter_chance: 20),
        (from: "lytzvia", to: "penhyla", leagues: 157, encounter_chance: 20),
        (from: "penhyla", to: "ebynshor", leagues: 45, encounter_chance: 10),

        // ---- The Triadyk coast ----
        // This road joins nothing else on the screenshot. It runs on
        // north-east from Trystzor.
        (from: "ulugrozt", to: "vhimyst", leagues: 30, encounter_chance: 15),
        (from: "vhimyst", to: "trystzor", leagues: 32, encounter_chance: 15),
        // Not drawn on the map: Vinniv'pti is joined to Trystzor for now.
        (from: "trystzor", to: "vinniv-pti", leagues: 23, encounter_chance: 20),

        // ---- Lesser roads, drawn thinner on the map ----
        (from: "klate", to: "myvus", leagues: 19, encounter_chance: 20),
        (from: "myvus", to: "vlenen", leagues: 28, encounter_chance: 20),
        (from: "vlenen", to: "iden", leagues: 30, encounter_chance: 20),
        (from: "iden", to: "seawalt", leagues: 31, encounter_chance: 20),
        (from: "corvus", to: "iden", leagues: 23, encounter_chance: 20),
        (from: "corvus", to: "vlenen", leagues: 20, encounter_chance: 20),
        (from: "vlenen", to: "danon", leagues: 58, encounter_chance: 25),
        // A track over the hills with switchbacks. Hesseh passes through
        // Drazihaim on his way to Maphlamar: by Atzhaim, Heedhaim and this.
        (from: "heedhaim", to: "maphlamar", leagues: 134, encounter_chance: 35),
        // Over the mountains from the Great Valley into Aphlora, then down
        // the river to Sima.
        (from: "atzch-midili", to: "bahour-ilos", leagues: 99, encounter_chance: 30),
        (from: "bahour-ilos", to: "sima", leagues: 53, encounter_chance: 25),
        // The road along the foot of the cliffs, between the Maphyk plateau
        // and the Koloudian desert. It runs on east from Narhutz.
        (from: "sthepenhall", to: "ayn-daiun", leagues: 143, encounter_chance: 30),
        (from: "ayn-daiun", to: "narhutz", leagues: 55, encounter_chance: 30),
    ],

    people: [
        // A stand-in for the player. Followers, prelates and governors go
        // here once the cast of the era is decided.
        // ASSUMPTION: the whole sheet, until character creation chooses it.
        // Health, fatigue, resilience and level are left out, so they stay
        // at their base. The pack is the party's starting supplies, three
        // sample item effects, and one item for each equipment slot.
        // Weight, value and durability are 1 until a rule names them.
        // Food, water, wood and copper start at Basic rarity.
        // Food restores 10 health when a camp consumes it, never past 100.
        // The Hearth Stone
        // raises max resilience by 10 while it is carried. The Pulse Cord
        // adds 5 vitality while it is worn, after the derived floor of
        // sqrt(health * fatigue). Worn items are not in this pack until
        // they are taken off.
        (
            key: "pylgrym",
            name: "The Pylgrym",
            title: "Pylgrym",
            at: "yhlgrym",
            in_party: true,
            sheet: (
                role: Player,
                age: 20,
                blood: Red,
                heritage: Shentzi,
                akstada: Pylgrym,
                tongues: [Shentz, Maphlian],
                background: "Pylgrym",
                primary: Player,
                inventory: [
                    (name: "Wood", type: Wood, weight: 1, value: 1, count: 5, durability: 1, rarity: Basic),
                    (name: "Water", type: Water, weight: 1, value: 1, count: 5, durability: 1, rarity: Basic),
                    (
                        name: "Food",
                        type: Food,
                        weight: 1,
                        value: 1,
                        count: 5,
                        durability: 1,
                        rarity: Basic,
                        effects: [(kind: Consumed, payload: RestoreHealth(amount: 10))],
                    ),
                    (name: "Copper", type: Copper, weight: 1, value: 1, count: 10, durability: 1, rarity: Basic),
                    (
                        name: "Hearth Stone",
                        type: Goods,
                        weight: 1,
                        value: 1,
                        count: 1,
                        durability: 1,
                        rarity: Basic,
                        effects: [(kind: Inventory, payload: RaiseMaxResilience(amount: 10))],
                    ),
                    (
                        name: "Pulse Cord",
                        type: Goods,
                        weight: 1,
                        value: 1,
                        count: 1,
                        durability: 1,
                        rarity: Basic,
                        slot: Neck,
                        effects: [(kind: Equipment, payload: AddVitality(amount: 5))],
                    ),
                    (name: "Trail Shoes", type: Goods, weight: 1, value: 1, count: 1, durability: 1, rarity: Basic, slot: Shoes),
                    (name: "Trail Breeches", type: Goods, weight: 1, value: 1, count: 1, durability: 1, rarity: Basic, slot: Legs),
                    (name: "Trail Coat", type: Goods, weight: 1, value: 1, count: 1, durability: 1, rarity: Basic, slot: Body),
                    (name: "Trail Bracers", type: Goods, weight: 1, value: 1, count: 1, durability: 1, rarity: Basic, slot: Arms),
                    (name: "Trail Gloves", type: Goods, weight: 1, value: 1, count: 1, durability: 1, rarity: Basic, slot: Gloves),
                    (name: "Trail Hood", type: Goods, weight: 1, value: 1, count: 1, durability: 1, rarity: Basic, slot: Head),
                    (name: "Trail Roll", type: Goods, weight: 1, value: 1, count: 1, durability: 1, rarity: Basic, slot: Back),
                    (name: "Trail Staff", type: Goods, weight: 1, value: 1, count: 1, durability: 1, rarity: Basic, slot: MainHand),
                    (name: "Trail Knife", type: Goods, weight: 1, value: 1, count: 1, durability: 1, rarity: Basic, slot: OffHand),
                    (name: "Trail Robes", type: Goods, weight: 1, value: 1, count: 1, durability: 1, rarity: Basic, slot: Robes),
                    (name: "Trail Torc", type: Goods, weight: 1, value: 1, count: 1, durability: 1, rarity: Basic, slot: Neck),
                ],
            ),
        ),

        // ---- Followers ----
        // Template followers, to try out the party. ASSUMPTION: both sheets.
        (
            // Travels with the Pylgrym from the start.
            key: "donold",
            name: "Donold Audsen",
            title: "Follower",
            at: "yhlgrym",
