        nodes: [
            (
                key: "start",
                line: "Well how ya do there fellow traveller? You don\'t look like you\'re from around here, though, honestly, I wouldn\'t know, since, ya know, I\'m not from around here either. I\'m Maikah. Pleasure to make your acquaintence!",
                sprite: None,
                choices: [
