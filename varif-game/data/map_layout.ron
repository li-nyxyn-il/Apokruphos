// Where each place sits on the map, for the window (varif-gui) to draw.
// The rules of the world never read this file.
//
// Each entry is a place's key and its position on "The_Umbara_City_Names.png"
// (the same picture as "umbara_roads_only.png", the window's map background,
// without the names), in pixels from the top-left corner of the full
// 2770 x 2316 image. Each position is the centre of the place's dot, found
// on the roads-only map and matched to its name on the City Names map.
// A place with no entry here is drawn beside one of its neighbours.
{
    // ASSUMPTION: Yhlgrym has no name on the map. This puts it on the
    // unnamed dot on the canyon road a little above the falls, which is
    // about its 15 leagues from them.
    "yhlgrym": (1226, 1161),
    "falls": (1192, 1205),
    "hylhaim": (1354, 1121),
    "heedhaim": (1461, 1042),
